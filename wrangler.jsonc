{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newsnow",
  "compatibility_date": "2025-11-08",
  "assets": {
    "directory": "./dist/output/public"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
